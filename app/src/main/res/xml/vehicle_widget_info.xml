<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis="0" — no auto-refresh timer. The only way this widget
  ever refreshes is a tap (see VehicleWidgetProvider's ACTION_REFRESH), which
  is exactly what was asked for and avoids polling the home server on a
  timer for data that only changes when someone logs a service.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_vehicle"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
