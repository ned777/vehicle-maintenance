<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed size, not resizable (resizeMode="none") — tall enough for a
  two-line vehicle name plus up to four rows. updatePeriodMillis="0" — no
  auto-refresh timer, the only way this widget refreshes is a tap (see
  VehicleWidgetProvider's ACTION_REFRESH). configure points at
  WidgetConfigActivity, which asks which vehicle to watch before the widget
  is actually placed.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="220dp"
    android:targetCellWidth="2"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_vehicle"
    android:configure="com.vehiclemaintenance.app.WidgetConfigActivity"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
