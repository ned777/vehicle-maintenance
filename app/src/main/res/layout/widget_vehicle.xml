<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's own layout (see vehicle_widget_info.xml for its fixed size).
  Only one of allGoodText / itemsList is visible at a time —
  VehicleWidgetProvider.updateOneWidget() toggles which, and populates
  itemsList's rows (from widget_item_row.xml) in code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_outline_background"
    android:paddingTop="14dp"
    android:paddingBottom="6dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- Which vehicle this widget instance was configured to watch. Allowed
         to wrap to a second line (a long "2019 Subaru Forester"-style name
         forced onto one line was stretching/overflowing) with its own side
         margin so it doesn't run edge to edge. includeFontPadding="false"
         for the same reason as the item rows — every bit of unnecessary
         vertical space here is space stolen from the four rows below. -->
    <TextView
        android:id="@+id/vehicleNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:includeFontPadding="false"
        android:text="@string/app_name"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.03"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Shown only when there is nothing to list at all, or on error. -->
    <TextView
        android:id="@+id/allGoodText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/ok"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="" />

    <!-- Populated with four widget_item_row rows: Oil, Transmission,
         Differential, Spark Plugs, each with its mileage remaining. -->
    <LinearLayout
        android:id="@+id/itemsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

</LinearLayout>
