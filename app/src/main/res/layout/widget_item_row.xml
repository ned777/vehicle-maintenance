<?xml version="1.0" encoding="utf-8"?>
<!--
  One row: a colored status dot plus the service name only, no detail line —
  a 2x2 widget doesn't have room for both, and the label alone is enough at
  a glance. The same layout doubles as the "Read more" row (see
  VehicleWidgetProvider.buildReadMoreRow()), which is why the root has an id
  of its own: that's what gets its own setOnClickPendingIntent to open the
  app, distinct from the rest of the widget's tap-to-refresh.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/ledDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/widget_led_overdue" />

    <TextView
        android:id="@+id/itemLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="" />

</LinearLayout>
